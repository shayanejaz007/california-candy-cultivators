# --- Data driver -----------------------------------------------------------
# supabase  (default) production persistence
# file                local development only; refused on serverless hosts
DATA_DRIVER=supabase

# ---------------------------------------------------------------------------
# Copy to .env.local for development, and set the same keys in your host's
# environment (Vercel / Railway / Fly / systemd) for production.
# Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Admin access ----------------------------------------------------------

# Password for the /admin panel. Use a long random passphrase, not a word.
ADMIN_PASSWORD=change-me

# Random 32+ char string used to sign the admin session cookie.
# Generate one with:  npm run secret
SESSION_SECRET=replace-with-a-long-random-string

# --- Public site -----------------------------------------------------------

# Minimum age enforced by the entry gate. Differs by jurisdiction.
NEXT_PUBLIC_AGE_LIMIT=21

# Age-gate testing override. Leave false in normal production.
# `npm run dev` always shows the homepage age gate automatically.
AGE_GATE_ALWAYS_SHOW=false

# Canonical origin, no trailing slash. Used for sitemap, robots and OG tags.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Data store ------------------------------------------------------------

# Temporary deployment mode. Leave this as demo until Supabase is connected.
#   demo     - bundled sample catalogue; no database required; writes are not persistent.
#   file     - local JSON development only; never use on Vercel.
#   supabase - persistent production mode once your keys and schema are ready.

# When true, public READS fall back to demo content if Supabase is temporarily unavailable.
# Set this to false only after Supabase is fully configured and verified.

# Only used by DATA_DRIVER=file for local development.
DATA_DIR=./data

# Only read when DATA_DRIVER=supabase.
# The service role key bypasses RLS. It is server-only: never prefix it with
# NEXT_PUBLIC_ and never import the supabase driver from a 'use client' file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Alternative to SUPABASE_SERVICE_ROLE_KEY for projects using Supabase secret keys:
SUPABASE_SECRET_KEY=

# Safe browser credentials used only for signed direct Storage uploads.
# These are not secrets. The service-role key above MUST remain server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Infrastructure --------------------------------------------------------

# Set to 1 only when the app sits behind a proxy you control (Vercel, Cloudflare,
# nginx). It makes rate limiting trust the X-Forwarded-For header.
# Leave unset if the app is directly exposed: a client can forge that header and
# walk straight past every rate limit.
TRUST_PROXY=1

# Optional. Every new inquiry is POSTed here as JSON so someone is actually
# told about it. Works with Zapier, Make, Slack, or your own endpoint.
INQUIRY_WEBHOOK_URL=

# --- Supabase (required for the admin to save prices) -----------------------
# Both key generations are accepted:
#   legacy   NEXT_PUBLIC_SUPABASE_ANON_KEY  +  SUPABASE_SERVICE_ROLE_KEY
#   current  NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  +  SUPABASE_SECRET_KEY

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only. Bypasses row-level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
